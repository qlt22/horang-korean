  "grammar": [
    {
      "id": "g22",
      "unitId": "u07_family",
      "order": 1,
      "label": "possessive",
      "ko": "의",
      "pattern": "N + 의",
      "explanation": "의 marks the owner: 저의 어머니 = my mother. In speech it often sounds like 에 and is frequently dropped: 우리 가족 사진.",
      "examples": [
        {
          "ko": "이분은 저의 어머니예요.",
          "en": "This person is my mother."
        },
        {
          "ko": "이 사진은 우리 가족의 사진이에요.",
          "en": "This photo is a photo of my family."
        }
      ],
      "mistake": "저에 어머니 ✗ → 저의 어머니 ✓"
    },
    {
      "id": "g23",
      "unitId": "u07_family",
      "order": 2,
      "label": "honorific ending",
      "ko": "-(으)시-",
      "pattern": "V-(으)시-",
      "explanation": "Add -시- before the ending when the subject is older or a stranger: 가다 → 가세요, 있다 → 있으세요, 먹다 → 드세요. The subject marker becomes 께서.",
      "examples": [
        {
          "ko": "어머니께서는 댁에 계세요.",
          "en": "My mother is at home."
        },
        {
          "ko": "할아버지께서는 일찍 주무세요.",
          "en": "Grandfather goes to bed early."
        }
      ],
      "mistake": "어머니가 계세요 ✗ → 어머니께서 계세요 ✓"
    },
    {
      "id": "g24",
      "unitId": "u07_family",
      "order": 3,
      "label": "age",
      "ko": "살",
      "pattern": "N + 살",
      "explanation": "Age uses the native numbers plus 살: 열 살, 스무 살, 서른 살. For an older person you can also say 연세가 많으세요.",
      "examples": [
        {
          "ko": "제 나이는 스무 살이에요.",
          "en": "I am twenty years old."
        },
        {
          "ko": "여동생은 몇 살이에요?",
          "en": "How old is your little sister?"
        }
      ],
      "mistake": "스물 살 ✗ → 스무 살 ✓ (스물 changes before a counter)"
    },
    {
      "id": "g47",
      "unitId": "u07_family",
      "order": 4,
      "label": "to / from a person",
      "ko": "한테 / 에게",
      "pattern": "N + 한테/에게",
      "explanation": "에게 (한테 in speech) marks the person you give to. 한테서/에게서 marks the person you get something from. Use 께 for elders.",
      "examples": [
        {
          "ko": "친구에게 선물을 보내요.",
          "en": "I send a present to a friend."
        },
        {
          "ko": "할머니께 편지를 드려요.",
          "en": "I give a letter to my grandmother."
        }
      ],
      "mistake": "할머니한테 편지를 드려요 ✗ → 할머니께 편지를 드려요 ✓"
    }
  ],
