  "grammar": [
    {
      "id": "g12",
      "unitId": "u04_shopping",
      "order": 1,
      "label": "Sino-Korean numbers and money",
      "ko": "숫자와 돈",
      "pattern": "N + 원",
      "explanation": "Prices use Sino-Korean numbers: 일 이 삼 사 오 육 칠 팔 구 십 백 천. Say the number, then 원.",
      "examples": [
        {
          "ko": "이 가방은 삼천 원이에요.",
          "en": "This bag is 3,000 won."
        },
        {
          "ko": "이거는 오백 원이에요.",
          "en": "This one is 500 won."
        }
      ],
      "mistake": "세천 원 ✗ → 삼천 원 ✓ (money uses Sino numbers)"
    },
    {
      "id": "g13",
      "unitId": "u04_shopping",
      "order": 2,
      "label": "this / that / that over there",
      "ko": "이/그/저",
      "pattern": "이/그/저 + N",
      "explanation": "이 = this near me, 그 = that near you, 저 = that over there. They always go before a noun.",
      "examples": [
        {
          "ko": "이 옷은 얼마예요?",
          "en": "How much are these clothes?"
        },
        {
          "ko": "저 가방이 예뻐요.",
          "en": "That bag over there is pretty."
        }
      ],
      "mistake": "그것 가방 ✗ → 그 가방 ✓"
    },
    {
      "id": "g25",
      "unitId": "u04_shopping",
      "order": 3,
      "label": "only (만)",
      "ko": "만",
      "pattern": "N + 만",
      "explanation": "Add 만 to a noun to mean 'only'. It replaces 은/는 or 을/를, so the two are never used together.",
      "examples": [
        {
          "ko": "이 가게는 현금만 받아요.",
          "en": "This shop only takes cash."
        },
        {
          "ko": "저는 이 모자만 사요.",
          "en": "I'm only buying this hat."
        }
      ],
      "mistake": "현금을만 받아요 ✗ → 현금만 받아요 ✓"
    },
    {
      "id": "g46",
      "unitId": "u04_shopping",
      "order": 4,
      "label": "more / the most (더/제일)",
      "ko": "더/제일",
      "pattern": "더 + Adj / 제일 + Adj",
      "explanation": "더 before an adjective means 'more'; 제일 means 'the most'. Both sit directly before the adjective.",
      "examples": [
        {
          "ko": "이 양말이 더 싸요.",
          "en": "These socks are cheaper."
        },
        {
          "ko": "저거는 제일 예뻐요.",
          "en": "That one is the prettiest."
        }
      ],
      "mistake": "더 싸요 = cheaper / 제일 싸요 = the cheapest"
    }
  ],
