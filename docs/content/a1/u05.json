  "grammar": [
    {
      "id": "g15",
      "unitId": "u05_places",
      "order": 1,
      "label": "go to a place",
      "ko": "에 가다",
      "pattern": "N + 에 가요",
      "explanation": "Put 에 after the place you go to. It works with 가다 and 오다: 도서관에 가요 = I go to the library.",
      "examples": [
        {
          "ko": "도서관에 가요.",
          "en": "I go to the library."
        },
        {
          "ko": "시장에 같이 가요.",
          "en": "Let's go to the market together."
        }
      ],
      "mistake": "도서관을 가요 ✗ → 도서관에 가요 ✓"
    },
    {
      "id": "g16",
      "unitId": "u05_places",
      "order": 2,
      "label": "at / from a place",
      "ko": "에서",
      "pattern": "N + 에서",
      "explanation": "에서 marks where an action happens, or where you start from. Compare 도서관에 가요 (going there) with 도서관에서 공부해요 (studying there).",
      "examples": [
        {
          "ko": "도서관에서 공부해요.",
          "en": "I study at the library."
        },
        {
          "ko": "버스에서 내려요.",
          "en": "I get off the bus."
        }
      ],
      "mistake": "도서관에 공부해요 ✗ → 도서관에서 공부해요 ✓"
    },
    {
      "id": "g17",
      "unitId": "u05_places",
      "order": 3,
      "label": "toward / by means of",
      "ko": "-(으)로",
      "pattern": "N + (으)로",
      "explanation": "으로 after a consonant, 로 after a vowel or ㄹ. It gives a direction (왼쪽으로) or a means (지하철로, 택시로).",
      "examples": [
        {
          "ko": "왼쪽으로 가세요.",
          "en": "Please go to the left."
        },
        {
          "ko": "지하철로 가요.",
          "en": "I go by subway."
        }
      ],
      "mistake": "지하철으로 가요 ✗ → 지하철로 가요 ✓ (ㄹ drops)"
    },
    {
      "id": "g18",
      "unitId": "u05_places",
      "order": 4,
      "label": "where is it?",
      "ko": "어디 / 위치",
      "pattern": "N이/가 어디예요? / 앞·뒤·옆",
      "explanation": "어디예요? asks where something is. Answer with a position word plus 에: 은행이 도서관 옆에 있어요.",
      "examples": [
        {
          "ko": "약국이 어디예요?",
          "en": "Where is the pharmacy?"
        },
        {
          "ko": "은행이 도서관 옆에 있어요.",
          "en": "The bank is next to the library."
        }
      ],
      "mistake": "은행이 어디에요? ✗ → 은행이 어디예요? ✓"
    }
  ],
