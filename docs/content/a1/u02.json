  "grammar": [
    {
      "id": "g04",
      "unitId": "u02_daily",
      "order": 1,
      "label": "there is / I have (있어요/없어요)",
      "ko": "있어요/없어요",
      "pattern": "N이/가 있어요 / 없어요",
      "explanation": "있어요 means something exists or you have it; 없어요 means it doesn't. The thing takes 이/가.",
      "examples": [
        {
          "ko": "냉장고에 우유가 있어요.",
          "en": "There is milk in the fridge."
        },
        {
          "ko": "제 방에 시계가 없어요.",
          "en": "There is no clock in my room."
        }
      ],
      "mistake": "우유를 있어요 ✗ → 우유가 있어요 ✓"
    },
    {
      "id": "g05",
      "unitId": "u02_daily",
      "order": 2,
      "label": "place and time particle (에)",
      "ko": "에",
      "pattern": "N + 에",
      "explanation": "Put 에 after a place to say where something is, or after a time to say when. Its shape never changes.",
      "examples": [
        {
          "ko": "제 방에 책상이 있어요.",
          "en": "There is a desk in my room."
        },
        {
          "ko": "아침에 운동해요.",
          "en": "I exercise in the morning."
        }
      ],
      "mistake": "아침을 운동해요 ✗ → 아침에 운동해요 ✓"
    },
    {
      "id": "g06",
      "unitId": "u02_daily",
      "order": 3,
      "label": "polite present ending (-아요/어요)",
      "ko": "-아요/어요",
      "pattern": "V-아요 / V-어요",
      "explanation": "The polite present ending. Add 아요 after ㅏ or ㅗ, 어요 after other vowels; 하다 verbs become 해요.",
      "examples": [
        {
          "ko": "저는 매일 운동해요.",
          "en": "I exercise every day."
        },
        {
          "ko": "저는 밤에 책을 읽어요.",
          "en": "I read a book at night."
        }
      ],
      "mistake": "읽아요 ✗ → 읽어요 ✓"
    },
    {
      "id": "g07",
      "unitId": "u02_daily",
      "order": 4,
      "label": "negation (안)",
      "ko": "안",
      "pattern": "안 + V",
      "explanation": "Put 안 before the verb to say you don't do it. It is a choice, not an inability.",
      "examples": [
        {
          "ko": "저는 밤에 우유를 안 마셔요.",
          "en": "I don't drink milk at night."
        },
        {
          "ko": "저는 텔레비전을 안 봐요.",
          "en": "I don't watch TV."
        }
      ],
      "mistake": "저는 안 운동해요 ✗ → 저는 운동을 안 해요 ✓"
    }
  ],
