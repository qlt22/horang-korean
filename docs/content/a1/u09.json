  "sentences": [
    {
      "id": "s09_1_1",
      "unitId": "u09_past",
      "lessonId": "l09_1",
      "korean": "어제 친구를 만났어요.",
      "romanization": "eoje chingureul mannasseoyo.",
      "english": "I met a friend yesterday.",
      "literal": "Yesterday, a friend met.",
      "gloss": [
        { "ko": "어제", "rom": "eoje", "en": "yesterday" },
        { "ko": "친구를", "rom": "chingureul", "en": "a friend (object)" },
        { "ko": "만났어요", "rom": "mannasseoyo", "en": "met" }
      ],
      "grammarIds": ["g30"],
      "wordIds": ["w09_01", "w09_05"],
      "register": "polite",
      "difficulty": 1,
      "distractors": [
        "I met a friend today.",
        "I didn't meet a friend yesterday.",
        "I will meet a friend tomorrow."
      ],
      "notes": "만나다 drops its ㄷ and takes -았어요: 만나 + 았어요 = 만났어요."
    },
    {
      "id": "s09_1_2",
      "unitId": "u09_past",
      "lessonId": "l09_1",
      "korean": "어젯밤에 라면을 먹었어요.",
      "romanization": "eojenbam-e ramyeoneul meogeosseoyo.",
      "english": "I ate ramen last night.",
      "literal": "Last night, ramen ate.",
      "gloss": [
        { "ko": "어젯밤에", "rom": "eojenbam-e", "en": "last night" },
        { "ko": "라면을", "rom": "ramyeoneul", "en": "ramen (object)" },
        { "ko": "먹었어요", "rom": "meogeosseoyo", "en": "ate" }
      ],
      "grammarIds": ["g30"],
      "wordIds": ["w09_02", "w09_06"],
      "register": "polite",
      "difficulty": 1,
      "distractors": [
        "I ate ramen this morning.",
        "I didn't eat ramen last night.",
        "I made ramen last night."
      ],
      "notes": "먹다 has ㅓ, so it takes -었어요, not -았어요."
    },
    {
      "id": "s09_1_3",
      "unitId": "u09_past",
      "lessonId": "l09_1",
      "korean": "지난주에 시장에 갔어요.",
      "romanization": "jinanju-e sijang-e gasseoyo.",
      "english": "I went to the market last week.",
      "literal": "Last week, to the market went.",
      "gloss": [
        { "ko": "지난주에", "rom": "jinanju-e", "en": "last week" },
        { "ko": "시장에", "rom": "sijang-e", "en": "to the market" },
        { "ko": "갔어요", "rom": "gasseoyo", "en": "went" }
      ],
      "grammarIds": ["g30"],
      "wordIds": ["w09_03", "w09_07"],
      "register": "polite",
      "difficulty": 1,
      "distractors": [
        "I went to the market yesterday.",
        "I didn't go to the market last week.",
        "I will go to the market next week."
      ],
      "notes": "가다 has ㅏ, so 가 + 았어요 = 갔어요. The ㅏ merges into ㅆ."
    },
    {
      "id": "s09_1_4",
      "unitId": "u09_past",
      "lessonId": "l09_1",
