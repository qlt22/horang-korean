      "literal": "The day before yesterday, a friend to our house came.",
      "gloss": [
        { "ko": "그저께", "rom": "geujeokke", "en": "the day before yesterday" },
        { "ko": "친구가", "rom": "chinguga", "en": "a friend (subject)" },
        { "ko": "우리 집에", "rom": "uri jib-e", "en": "to our house" },
        { "ko": "왔어요", "rom": "wasseoyo", "en": "came" }
      ],
      "grammarIds": ["g30"],
      "wordIds": ["w09_04", "w09_08"],
      "register": "polite",
      "difficulty": 2,
      "distractors": [
        "A friend came to our house yesterday.",
        "I went to a friend's house the day before yesterday.",
        "A friend didn't come to our house."
      ],
      "notes": "오다 → 오 + 았어요 = 왔어요. The subject takes 가 because 친구 is the one who came."
    },
