  "grammar": [
    {
      "id": "g30",
      "unitId": "u09_past",
      "order": 1,
      "label": "past tense (았/었어요)",
      "ko": "-았/었어요",
      "pattern": "V-았/었어요",
      "explanation": "Add -았어요 after ㅏ or ㅗ and -었어요 after the other vowels. 하다 verbs always become 했어요: 가다 → 갔어요, 먹다 → 먹었어요, 하다 → 했어요.",
      "examples": [
        { "ko": "어제 친구를 만났어요.", "en": "I met a friend yesterday." },
        { "ko": "밤에는 책을 읽었어요.", "en": "At night I read a book." }
      ],
      "mistake": "먹았어요 ✗ → 먹었어요 ✓"
    },
    {
      "id": "g31",
      "unitId": "u09_past",
      "order": 2,
      "label": "and then (-고)",
      "ko": "-고",
      "pattern": "V-고",
      "explanation": "Attach -고 to a verb stem to put two actions in one sentence. The tense goes on the last verb only: 청소하고 빨래했어요.",
      "examples": [
        { "ko": "청소하고 빨래했어요.", "en": "I cleaned and did the laundry." },
        { "ko": "수업이 끝나고 도서관에 갔어요.", "en": "Class ended and I went to the library." }
      ],
      "mistake": "청소했고 빨래했어요 △ → 청소하고 빨래했어요 ✓"
    },
    {
      "id": "g32",
      "unitId": "u09_past",
      "order": 3,
      "label": "so (그래서)",
      "ko": "그래서",
      "pattern": "clause + 그래서 + clause",
      "explanation": "Put the reason first, then 그래서, then the result. It links two full clauses, so each side has its own verb.",
      "examples": [
        { "ko": "약속이 많았어요. 그래서 바빴어요.", "en": "I had a lot of appointments. So I was busy." },
        { "ko": "늦게 잤어요. 그래서 피곤했어요.", "en": "I went to bed late. So I was tired." }
      ],
      "mistake": "바빴어요 그래서 약속이 많았어요 ✗ → 약속이 많았어요. 그래서 바빴어요 ✓"
    },
    {
      "id": "g33",
      "unitId": "u09_past",
      "order": 4,
      "label": "but (-지만)",
      "ko": "-지만",
      "pattern": "V-지만",
      "explanation": "Attach -지만 to the stem to say 'although A, B'. The first half is a fact you accept, the second half is the surprise.",
      "examples": [
        { "ko": "시험은 어려웠지만 재미있었어요.", "en": "The exam was difficult but interesting." },
        { "ko": "카페는 조용했지만 음악이 좋았어요.", "en": "The cafe was quiet but the music was good." }
      ],
      "mistake": "바쁘지만어요 ✗ → 바쁘지만 ✓"
    }
  ],
