  "grammar": [
    {
      "id": "g19",
      "unitId": "u06_time",
      "order": 1,
      "label": "telling the time",
      "ko": "시 / 분",
      "pattern": "N시 N분",
      "explanation": "Hours take native numbers (한 시, 두 시, 세 시) and minutes take Sino numbers (오 분, 삼십 분). 반 means half past.",
      "examples": [
        {
          "ko": "지금은 두 시 삼십 분이에요.",
          "en": "It is 2:30 now."
        },
        {
          "ko": "회의는 세 시에 시작해요.",
          "en": "The meeting starts at three."
        }
      ],
      "mistake": "두 시 스무 분 ✗ → 두 시 이십 분 ✓ (minutes are Sino)"
    },
    {
      "id": "g20",
      "unitId": "u06_time",
      "order": 2,
      "label": "days and dates",
      "ko": "요일 / 날짜",
      "pattern": "월요일 / N월 N일",
      "explanation": "The days end in -요일. Dates go big to small: 년, 월, 일, all with Sino numbers. 오월 십일 = May 10.",
      "examples": [
        {
          "ko": "수요일은 수업이 없어요.",
          "en": "There is no class on Wednesday."
        },
        {
          "ko": "제 생일은 오월 십일이에요.",
          "en": "My birthday is May 10."
        }
      ],
      "mistake": "오월 십일일 ✗ → 오월 십일 ✓ (일 is already the day)"
    },
    {
      "id": "g21",
      "unitId": "u06_time",
      "order": 3,
      "label": "from … until …",
      "ko": "부터 / 까지",
      "pattern": "N부터 N까지",
      "explanation": "부터 marks the start and 까지 the end. They often travel together: 아홉 시부터 다섯 시까지 = from nine to five.",
      "examples": [
        {
          "ko": "아홉 시부터 다섯 시까지 일해요.",
          "en": "I work from nine to five."
        },
        {
          "ko": "월요일부터 금요일까지 회의가 있어요.",
          "en": "I have meetings from Monday to Friday."
        }
      ],
      "mistake": "아홉 시에부터 ✗ → 아홉 시부터 ✓"
    },
    {
      "id": "g48",
      "unitId": "u06_time",
      "order": 4,
      "label": "when I do…",
      "ko": "-(으)ㄹ 때",
      "pattern": "V-(으)ㄹ 때",
      "explanation": "Take 다 off the verb: after a consonant add -을 때, after a vowel add -ㄹ 때. 시간이 있을 때 = when I have time.",
      "examples": [
        {
          "ko": "시간이 있을 때 쉬어요.",
          "en": "When I have time, I rest."
        },
        {
          "ko": "수업이 끝날 때 전화해요.",
          "en": "I call when class ends."
        }
      ],
      "mistake": "끝나을 때 ✗ → 끝날 때 ✓"
    }
  ],
