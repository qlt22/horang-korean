  "grammar": [
    {
      "id": "g26",
      "unitId": "u08_hobbies",
      "order": 1,
      "label": "like / be good",
      "ko": "좋아해요 / 좋아요",
      "pattern": "N을/를 좋아해요 / N이 좋아요",
      "explanation": "좋아해요 is a verb: you like something (축구를 좋아해요). 좋아요 is an adjective: the thing itself is good (축구가 좋아요).",
      "examples": [
        {
          "ko": "저는 축구를 좋아해요.",
          "en": "I like soccer."
        },
        {
          "ko": "노래와 춤이 아주 좋아요.",
          "en": "Singing and dancing are really good."
        }
      ],
      "mistake": "저는 축구를 좋아요 ✗ → 저는 축구를 좋아해요 ✓"
    },
    {
      "id": "g27",
      "unitId": "u08_hobbies",
      "order": 2,
      "label": "can do",
      "ko": "-(으)ㄹ 수 있어요",
      "pattern": "V-(으)ㄹ 수 있어요",
      "explanation": "Take 다 off the verb: after a vowel add -ㄹ 수 있어요, after a consonant -을 수 있어요. The negative is -ㄹ 수 없어요.",
      "examples": [
        {
          "ko": "저는 기타를 칠 수 있어요.",
          "en": "I can play the guitar."
        },
        {
          "ko": "춤과 그림은 아직 할 수 없어요.",
          "en": "I still can't dance or draw."
        }
      ],
      "mistake": "배우수 있어요 ✗ → 배울 수 있어요 ✓"
    },
    {
      "id": "g28",
      "unitId": "u08_hobbies",
      "order": 3,
      "label": "well / cannot",
      "ko": "잘 / 못",
      "pattern": "잘 V / 못 V",
      "explanation": "잘 before a verb means 'do it well'. 못 before a verb means 'cannot do it'. Both sit right before the verb: 잘해요, 못해요, 잘 못해요.",
      "examples": [
        {
          "ko": "저는 노래를 잘해요.",
          "en": "I am good at singing."
        },
        {
          "ko": "동생은 수영을 못해요.",
          "en": "My little sibling can't swim."
        }
      ],
      "mistake": "못 수영해요 ✗ → 수영을 못해요 ✓"
    },
    {
      "id": "g29",
      "unitId": "u08_hobbies",
      "order": 4,
      "label": "want to do",
      "ko": "-고 싶어요",
      "pattern": "V-고 싶어요",
      "explanation": "Attach -고 싶어요 to the verb stem to say what you want to do: 배우다 → 배우고 싶어요. The subject is usually 저는 or 나는.",
      "examples": [
        {
          "ko": "저는 기타를 배우고 싶어요.",
          "en": "I want to learn the guitar."
        },
        {
          "ko": "언제 등산을 하고 싶어요?",
          "en": "When do you want to go hiking?"
        }
      ],
      "mistake": "배우다 싶어요 ✗ → 배우고 싶어요 ✓"
    }
  ],
