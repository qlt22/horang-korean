  "dialogue": {
    "id": "d08",
    "unitId": "u08_hobbies",
    "title": "The photo club",
    "setting": "A student tells a friend about a club at school.",
    "lines": [
      {
        "id": "d08_1",
        "speaker": "A",
        "ko": "취미가 뭐예요?",
        "rom": "chwimiga mwoyeyo?",
        "en": "What's your hobby?"
      },
      {
        "id": "d08_2",
        "speaker": "B",
        "ko": "저는 사진과 영화를 좋아해요.",
        "rom": "jeoneun sajingwa yeonghwareul joahaeyo.",
        "en": "I like photography and movies."
      },
      {
        "id": "d08_3",
        "speaker": "A",
        "ko": "왜 사진을 좋아해요?",
        "rom": "wae sajineul joahaeyo?",
        "en": "Why do you like photography?"
      },
      {
        "id": "d08_4",
        "speaker": "B",
        "ko": "사진이 아주 재미있어요.",
        "rom": "sajini aju jaemiisseoyo.",
        "en": "Photography is really fun."
      },
      {
        "id": "d08_5",
        "speaker": "A",
        "ko": "우리 사진 동아리에 같이 가요.",
        "rom": "uri sajin dongarie gachi gayo.",
        "en": "Come to our photo club with me."
      },
      {
        "id": "d08_6",
        "speaker": "B",
        "ko": "사진 동아리에서 뭐를 해요?",
        "rom": "sajin dongarieseo mworeul haeyo?",
        "en": "What do you do in the photo club?"
      },
      {
        "id": "d08_7",
        "speaker": "A",
        "ko": "같이 사진을 찍어요. 영화도 만들어요.",
        "rom": "gachi sajineul jjigeoyo. yeonghwado mandeureoyo.",
        "en": "We take photos together. We make movies too."
      },
      {
        "id": "d08_8",
        "speaker": "B",
        "ko": "누구와 같이 해요?",
        "rom": "nuguwa gachi haeyo?",
        "en": "Who do you do it with?"
      },
      {
        "id": "d08_9",
        "speaker": "A",
        "ko": "회원들이 다 같이 해요. 나중에 모임에 오세요.",
        "rom": "hoewondeuri da gachi haeyo. najunge moime oseyo.",
        "en": "All the members do it together. Come to a meeting later."
      },
