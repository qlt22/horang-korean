  "grammar": [
    {
      "id": "g01",
      "unitId": "u01_intro",
      "order": 1,
      "label": "to be (이에요/예요)",
      "ko": "이에요/예요",
      "pattern": "N + 이에요/예요",
      "explanation": "The polite word for 'is / am / are'. Use 예요 after a vowel and 이에요 after a consonant.",
      "examples": [
        {
          "ko": "저는 의사예요.",
          "en": "I am a doctor."
        },
        {
          "ko": "제 친구는 학생이에요.",
          "en": "My friend is a student."
        }
      ],
      "mistake": "학생예요 ✗ → 학생이에요 ✓"
    },
    {
      "id": "g02",
      "unitId": "u01_intro",
      "order": 2,
      "label": "topic marker (은/는)",
      "ko": "은/는",
      "pattern": "N + 은/는",
      "explanation": "'As for N…' — it marks what the sentence is about. Use 은 after a consonant and 는 after a vowel.",
      "examples": [
        {
          "ko": "저는 유나예요.",
          "en": "I am Yuna."
        },
        {
          "ko": "이 사람은 제 동료예요.",
          "en": "This person is my colleague."
        }
      ],
      "mistake": "저가 학생이에요 ✗ → 저는 학생이에요 ✓"
    },
    {
      "id": "g03",
      "unitId": "u01_intro",
      "order": 3,
      "label": "subject marker (이/가)",
      "ko": "이/가",
      "pattern": "N + 이/가",
      "explanation": "Marks who or what does the action or has the quality. Use 이 after a consonant and 가 after a vowel.",
      "examples": [
        {
          "ko": "이름이 뭐예요?",
          "en": "What is your name?"
        },
        {
          "ko": "한국어가 어려워요.",
          "en": "Korean is difficult."
        }
      ],
      "mistake": "이름가 뭐예요? ✗ → 이름이 뭐예요? ✓"
    },
    {
      "id": "g14",
      "unitId": "u01_intro",
      "order": 4,
      "label": "also / too (도)",
      "ko": "도",
      "pattern": "N + 도",
      "explanation": "Add 도 to a noun to mean 'also / too'. It replaces 은/는 or 이/가 — never use both.",
      "examples": [
        {
          "ko": "저도 학생이에요.",
          "en": "I am a student too."
        },
        {
          "ko": "선생님도 미국 사람이에요.",
          "en": "The teacher is American too."
        }
      ],
      "mistake": "저는도 학생이에요 ✗ → 저도 학생이에요 ✓"
    }
  ],
