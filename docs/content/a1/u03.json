  "grammar": [
    {
      "id": "g08",
      "unitId": "u03_food",
      "order": 1,
      "label": "object marker (을/를)",
      "ko": "을/를",
      "pattern": "N + 을/를",
      "explanation": "Marks the thing the verb acts on: the food you eat, the menu you ask for. Use 을 after a consonant, 를 after a vowel.",
      "examples": [
        {
          "ko": "저는 김치를 먹어요.",
          "en": "I eat kimchi."
        },
        {
          "ko": "비빔밥을 주세요.",
          "en": "Bibimbap, please."
        }
      ],
      "mistake": "김치을 먹어요 ✗ → 김치를 먹어요 ✓"
    },
    {
      "id": "g09",
      "unitId": "u03_food",
      "order": 2,
      "label": "please give me (주세요)",
      "ko": "주세요",
      "pattern": "N + 주세요",
      "explanation": "Put 주세요 after the thing you want. It is already polite, so it works in every shop and restaurant.",
      "examples": [
        {
          "ko": "물 한 잔 주세요.",
          "en": "One glass of water, please."
        },
        {
          "ko": "계산서 주세요.",
          "en": "The bill, please."
        }
      ],
      "mistake": "물이 주세요 ✗ → 물 주세요 ✓"
    },
    {
      "id": "g10",
      "unitId": "u03_food",
      "order": 3,
      "label": "counters (개/잔/명)",
      "ko": "개/잔/명",
      "pattern": "N + 한 개 / 한 잔 / 한 명",
      "explanation": "Count with a counter: 개 for things, 잔 for drinks, 명 for people. 하나 and 둘 become 한 and 두 before a counter.",
      "examples": [
        {
          "ko": "계란 두 개 주세요.",
          "en": "Two eggs, please."
        },
        {
          "ko": "커피 한 잔 주세요.",
          "en": "One cup of coffee, please."
        }
      ],
      "mistake": "커피 한 개 ✗ → 커피 한 잔 ✓"
    },
    {
      "id": "g11",
      "unitId": "u03_food",
      "order": 4,
      "label": "cannot (못)",
      "ko": "못",
      "pattern": "못 + V",
      "explanation": "못 before a verb means you are unable to do it. 안 means you choose not to; 못 means you can't.",
      "examples": [
        {
          "ko": "저는 매운 김치를 못 먹어요.",
          "en": "I can't eat spicy kimchi."
        },
        {
          "ko": "저는 커피를 못 마셔요.",
          "en": "I can't drink coffee."
        }
      ],
      "mistake": "안 먹어요 = I don't eat it / 못 먹어요 = I can't eat it"
    }
  ],
